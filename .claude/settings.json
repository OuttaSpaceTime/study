{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__flashcard-mcp__(create_card|update_card|delete_card|delete_cards|resolve_leech|resolve_card_note|suspend_card|unsuspend_card|delete_deck)",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/Code/omvida/bin/omvida-deck-changed\" ] || \"$HOME/Code/omvida/bin/omvida-deck-changed\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(scripts/lint:*)",
      "Bash(scripts/wiki-write:*)",
      "Bash(scripts/wiki-search:*)",
      "Bash(scripts/anki-sync:*)",
      "Bash(curl -sf http://localhost:4777/*)",
      "Bash(xdg-open http://localhost:4777/*)",
      "Bash(cd wiki-viewer && setsid -f npm run dev*)",
      "Bash(cd wiki-viewer && npm test*)",
      "Bash(cd wiki-viewer && npm run lint*)",
      "Bash(cd wiki-viewer && npm run typecheck*)"
    ]
  }
}
