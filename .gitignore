# Python bytecode
__pycache__/

# Obsidian workspace (user-specific, changes constantly)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
wiki/.obsidian/workspace.json
wiki/.obsidian/workspace-mobile.json

# Obsidian scratch canvases
Untitled*.canvas

# TreeSearch index (rebuilt from wiki content)
wiki/indexes/

# Ollama embeddings cache (rebuilt from wiki content)
wiki/.embeddings.json

# Challenge attempts — written by the wiki-viewer app, read by /study
challenges/.attempts/

# Challenge project envs — specs and lockfiles committed, build artifacts not
challenges/envs/*/.venv/
challenges/envs/*/__pycache__/
challenges/envs/*/node_modules/
challenges/envs/*/.bundle/
challenges/envs/*/vendor/bundle/
challenges/envs/*/target/
