# Python bytecode
__pycache__/

# Obsidian workspace (user-specific, changes constantly)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
wiki/.obsidian/workspace.json
wiki/.obsidian/workspace-mobile.json

# Obsidian scratch canvases
Untitled*.canvas

# TreeSearch index (rebuilt from wiki content)
wiki/indexes/

# Ollama embeddings cache (rebuilt from wiki content)
wiki/.embeddings.json

# Probe per-topic envs — lockfiles are committed, build artifacts are not
probes/*/.venv/
probes/*/__pycache__/
probes/*/node_modules/
probes/*/.bundle/
probes/*/vendor/bundle/
probes/*/target/
