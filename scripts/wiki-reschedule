#!/usr/bin/env python3
"""Reschedule a wiki page after review."""
import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from scripts.wiki.reschedule import reschedule_page
from scripts.wiki.write import wiki_write


def main() -> None:
    parser = argparse.ArgumentParser(description="Reschedule a wiki page after review")
    parser.add_argument("page_path", help="Path to wiki page")
    parser.add_argument("rating", type=int, choices=[1, 2, 3, 4], help="Rating: 1=Again, 2=Hard, 3=Good, 4=Easy")
    parser.add_argument("--wiki-dir", default="wiki", help="Wiki directory")
    args = parser.parse_args()

    schedule = reschedule_page(Path(args.page_path), args.rating)
    print(json.dumps(schedule, ensure_ascii=False))

    # Re-index after frontmatter change
    result = wiki_write(Path(args.page_path), Path(args.wiki_dir))
    print(json.dumps(result, ensure_ascii=False), file=sys.stderr)


if __name__ == "__main__":
    main()
