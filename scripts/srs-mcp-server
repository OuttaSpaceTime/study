#!/bin/sh
# Launches the agentic-spaced-repetition MCP server at the path configured in .env.local.
# Kept dependency-free: anything written to stdout here would corrupt the
# MCP stdio stream, so only stderr is used for diagnostics.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# SRS_DIR, else FLASHCARD_MCP_DIR (its name before the rename), from the
# environment first and .env.local second.
dir=${SRS_DIR:-${FLASHCARD_MCP_DIR:-}}
if [ -z "$dir" ] && [ -f "$root/.env.local" ]; then
  for key in SRS_DIR FLASHCARD_MCP_DIR; do
    dir=$(sed -n "s/^[[:space:]]*$key[[:space:]]*=[[:space:]]*//p" "$root/.env.local" \
          | tail -n1 | tr -d "\"'")
    [ -n "$dir" ] && break
  done
fi
case $dir in
  "~/"*) dir=$HOME/${dir#"~/"} ;;
  '$HOME/'*) dir=$HOME/${dir#'$HOME/'} ;;
esac

if [ -z "$dir" ]; then
  echo "SRS_DIR (or the old FLASHCARD_MCP_DIR) is not set. Write it to $root/.env.local, e.g." >&2
  echo "    SRS_DIR=\$HOME/Code/agentic-spaced-repetition" >&2
  echo "See 'Machine-local configuration' in README.md." >&2
  exit 1
fi

server=$dir/src/mcp/server.ts
if [ ! -f "$server" ]; then
  echo "No agentic-spaced-repetition server at $server" >&2
  echo "Fix SRS_DIR in $root/.env.local." >&2
  exit 1
fi

DATABASE_URL="file:${FLASHCARD_MASTER_DB:-$dir/prisma/master.db}"
export DATABASE_URL
exec npx tsx "$server"
